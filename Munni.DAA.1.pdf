960 0 obj
<</Title(import time # Merge Sort Function def merge_sort\(arr\):     if len\(arr\) > 1:         # Find the middle of the array         mid = len\(arr\) // 2         # Divide the array into two halves         left = arr[:mid]         right = arr[mid:]         # Recursively sort both halves         merge_sort\(left\)         merge_sort\(right\)         i = j = k = 0         # Merge the sorted halves         while i < len\(left\) and j < len\(right\):             if left[i] < right[j]:                 arr[k] = left[i]                 i += 1             else:                 arr[k] = right[j]                 j += 1             k += 1         # Copy remaining elements of left half         while i < len\(left\):             arr[k] = left[i]             i += 1             k += 1)/Dest[17 0 R/Fit]/Parent 948 0 R/Next 977 0 R>>
endobj

