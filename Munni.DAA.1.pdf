<</Type/StructElem/S/H3/P 73 0 R/T(import time # Partition Function def partition\(arr, low, high\):     pivot = arr[high]      # Choose last element as pivot     i = low - 1     for j in range\(low, high\):         if arr[j] <= pivot:             i += 1             arr[i], arr[j] = arr[j], arr[i]     arr[i + 1], arr[high] = arr[high], arr[i + 1]     return i + 1 # Quick Sort Function def quick_sort\(arr, low, high\):     if low < high:)/E(import time # Partition Function def partition\(arr, low, high\):     pivot = arr[high]      # Choose last element as pivot     i = low - 1     for j in range\(low, high\):         if arr[j] <= pivot:             i += 1             arr[i], arr[j] = arr[j], arr[i]     arr[i + 1], arr[high] = arr[high], arr[i + 1]     return i + 1 # Quick Sort Function def quick_sort\(arr, low, high\):     if low < high:)/Pg 19 0 R/K[29]>>
endobj

